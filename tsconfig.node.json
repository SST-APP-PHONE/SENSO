{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["server", "shared", "api", "scripts/*.ts", "tests/server", "tests/e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "drizzle.config.ts"]
}
