# ===== SENSO — variables de entorno (copiar a .env; NUNCA subir .env) =====

# Conexión MySQL (servidor). Formato: mysql://usuario:contraseña@host:3306/base
# Si está definida, tiene prioridad sobre las variables DB_*.
DATABASE_URL=mysql://senso:CAMBIAR@localhost:3306/senso

# Alternativa a DATABASE_URL (p. ej. TiDB Cloud): se usa SOLO si DATABASE_URL no existe.
# Siempre conecta con TLS verificando el certificado del servidor. DB_PORT por defecto: 4000.
# DB_HOST=
# DB_PORT=4000
# DB_USERNAME=
# DB_PASSWORD=
# DB_DATABASE=senso

# Secreto para firmar las sesiones administrativas (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SECRET=

# Zona horaria usada para "Reportes hoy" en el centro de monitoreo
APP_TIMEZONE=America/Mexico_City

# Orígenes permitidos (CORS) separados por coma. Vacío = solo mismo origen.
CORS_ALLOWED_ORIGINS=

# Puerto del servidor local (no aplica en Vercel)
PORT=8787

# NODE_ENV=production lo define la plataforma (Vercel) o el comando de arranque.
# No ponerlo aquí: Vite lo leería y generaría un build de desarrollo.

# Base de datos para pruebas de servidor (el nombre DEBE contener "test"; se borra y recrea)
TEST_DATABASE_URL=mysql://senso:CAMBIAR@localhost:3306/senso_test
